{
  "name": "@dart-acdc/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for AI-assisted Dart-ACDC API client generation from OpenAPI specs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "@dart-acdc/mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "mcp",
    "openapi",
    "dart",
    "flutter",
    "dart-acdc",
    "code-generation"
  ],
  "license": "MIT"
}
